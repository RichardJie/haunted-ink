{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": false, "types": ["node"], "isolatedModules": true
  },
  "include": ["shared", "server", "src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
